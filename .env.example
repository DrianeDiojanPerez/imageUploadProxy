# Copy this file to .env and fill it in. The .env file is read at boot and
# never overrides a variable that is already exported in the shell.
#
# Quick reference, every value this service understands:
#
#   GH_IMAGE_DIR     any path inside the repo           default images
#   PUBLIC_BASE_URL  a url, no trailing slash           default http://localhost:3000
#   BIND_ADDRESS     host:port                          default 0.0.0.0:3000
#   MAX_UPLOAD_MB    1 to 100                           default 25
#   ALLOWED_TYPES    png, jpg, gif, webp, comma separated   default all four
#   CACHE_MAX_AGE    seconds, 0 for no-store            default 31536000
#   TIMEZONE         an IANA zone, America/Belize       default unset, UTC only
#   USAGE_FILE       a path to keep the call count in    default ./usage.json
#   UPLOAD_SECRET    any string, empty means no auth    default empty
#   LOG_FORMAT       pretty | json                      default pretty
#   RUST_LOG         a tracing filter                   default info
#
# Anything outside these values stops the process on boot and says so, so a
# typo is never left to turn up later as odd behaviour.

# Required. Fine grained token with Contents read and write on the repo.
# Values: github_pat_... as GitHub gives it to you.
GH_TOKEN=github_pat_...

# Required. The user or org that owns the repo.
# Values: any GitHub account name.
GH_OWNER=your-username

# Required. Public or private, the service serves the images either way.
# Values: any repo name owned by GH_OWNER.
GH_REPO=image-cdn

# Optional. The branch images are committed to.
# Values: any branch that already exists. Default main.
GH_BRANCH=main

# Optional. Where the files sit inside the repo. The URL stays
# /images/{name} whatever this says.
# Values: any path, slashes allowed. Default images.
GH_IMAGE_DIR=images

# Optional. Every URL handed back to a caller is built from this, so set it
# to the address the service answers on in production.
# Values: a url with the scheme and no trailing slash.
# Default http://localhost:3000.
PUBLIC_BASE_URL=http://localhost:3000

# Optional. Handy for running a second instance next to one that already
# holds the port.
# Values: host:port. Use 127.0.0.1 to keep it off the network.
# Default 0.0.0.0:3000.
BIND_ADDRESS=0.0.0.0:3000

# Optional. The largest image an upload may carry.
# Values: a whole number from 1 to 100, since GitHub gives up on the
# Contents API somewhere past that. Default 25.
MAX_UPLOAD_MB=25

# Optional. Narrows what an upload may be, it cannot add types beyond the
# four listed. jpeg counts as jpg.
# Values: any comma separated mix of png, jpg, gif, webp. Default all four.
ALLOWED_TYPES=png,jpg,gif,webp

# Optional. How long a served image may be cached. Stored names carry a uuid
# so the bytes never change under one, which is why a year is safe.
# Values: seconds as a whole number, or 0 to send no-store while debugging.
# Default 31536000, a year.
CACHE_MAX_AGE=31536000

# Optional. Where you are, so /usage can show the reset on your own clock
# next to the UTC one GitHub reports. Leave it out and only UTC is shown.
# Values: any IANA zone name, America/Belize, Asia/Kolkata, Europe/Madrid.
# The zone knows its own summer time, so nothing here needs changing twice a
# year even where the clocks move. The database is compiled in, so a slim
# container with no tzdata still understands these.
TIMEZONE=America/Belize

# Optional. Where to keep the api call count so it survives a restart.
# Values: any writable path. Set it to nothing at all to keep the count in
# memory instead, where it starts over every time the service does.
# GitHub's own figures are kept in here too, but only as the last thing it
# said, and they are ignored once the hour they belong to has passed.
USAGE_FILE=./usage.json

# Optional. Set it and uploads and deletes must send the same value in an
# x-upload-secret header. Reads stay open either way.
# Values: any string. Empty or missing leaves writing open to anyone.
UPLOAD_SECRET=

# Optional. The shape of the log lines.
# Values: pretty for a readable console, json for log shippers.
# Default pretty.
LOG_FORMAT=pretty

# Optional. Standard tracing filter.
# Values: anything RUST_LOG accepts, for example
# image_upload_proxy=debug to see the repo path behind each request.
# Default image_upload_proxy=info,tower_http=info.
RUST_LOG=image_upload_proxy=info,tower_http=info
